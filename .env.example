# ============================================
# 自动发卡商城 - 环境变量配置
# 复制此文件为 .env 并填入真实值
# 在 Vercel 后台也需要配置这些环境变量
# ============================================

# ---------- 支付宝当面付 ----------
# 支付宝应用ID（在支付宝开放平台创建应用后获取）
ALIPAY_APP_ID=your_alipay_app_id

# 应用私钥（RSA2私钥，不带 BEGIN/END 标记也可以，代码会自动处理）
ALIPAY_PRIVATE_KEY=your_alipay_private_key

# 支付宝公钥（不是应用公钥，是支付宝那边的公钥）
ALIPAY_PUBLIC_KEY=your_alipay_public_key

# 支付宝回调地址（必须是公网可访问的HTTPS地址）
# 格式：https://你的域名/api/notify
ALIPAY_NOTIFY_URL=https://your-domain.vercel.app/api/notify

# 是否使用沙箱环境（测试时设为 true，正式上线设为 false 或删除此行）
ALIPAY_SANDBOX=false

# ---------- Supabase 数据库 ----------
# Supabase 项目 URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase service_role key（有读写权限，不是 anon key）
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ---------- 管理后台 ----------
# 管理后台登录密码（请务必修改为强密码）
ADMIN_PASSWORD=your_strong_admin_password

# ---------- 安全 ----------
# 允许的前端域名（CORS），多个用逗号分隔，生产环境建议指定具体域名
# 例如：https://your-domain.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=*
