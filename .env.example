# ===== 数据库配置 =====
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===== 支付宝支付配置 =====
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
ALIPAY_NOTIFY_URL=https://your-domain.com/api/notify
ALIPAY_SANDBOX=false

# ===== 微信支付配置（微信支付 Native 扫码，APIv3） =====
# 商户平台：https://pay.weixin.qq.com
# AppID：微信公众平台/开放平台 的 AppID（需与商户号绑定）
WXPAY_APP_ID=your_wechat_appid
# 商户号：微信支付商户平台 商户号（10位数字）
WXPAY_MCH_ID=your_wechat_mch_id
# 商户API证书序列号：商户平台 -> API安全 -> API证书 中查看
WXPAY_SERIAL_NO=your_wechat_serial_no
# 商户API私钥：apiclient_key.pem 文件的完整内容
WXPAY_PRIVATE_KEY=your_wechat_private_key
# APIv3密钥：商户平台 -> API安全 -> APIv3密钥（32位）
WXPAY_API_V3_KEY=your_wechat_api_v3_key
# 支付回调地址（必须为公网 https 地址）
WXPAY_NOTIFY_URL=https://your-domain.com/api/notify
# （可选）手动指定微信支付平台证书公钥，不填则自动下载
WXPAY_PLATFORM_PUBLIC_KEY=

# ===== 邮件SMTP配置 =====
# QQ邮箱示例：smtp.qq.com / 465 / 邮箱地址 / 授权码
# 163邮箱示例：smtp.163.com / 465 / 邮箱地址 / 授权码
# Gmail示例：smtp.gmail.com / 587 / 邮箱地址 / 应用密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASS=your_smtp_auth_code
SMTP_FROM=your_email@qq.com

# ===== 站点配置 =====
NEXT_PUBLIC_SITE_URL=https://your-domain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
